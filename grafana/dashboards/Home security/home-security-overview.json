            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Open ports (latest scan)",
      "id": 11,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "lastScan = from(bucket: \"${hbucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"homesec_scan\" and r._field == \"open_ports\")\n  |> last()\n  |> findColumn(fn: (key) => true, column: \"_time\")\nt0 = if length(arr: lastScan) > 0 then lastScan[0] else now()\nfrom(bucket: \"${hbucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"homesec_scan_port\")\n  |> filter(fn: (r) => r._time == t0)\n  |> pivot(rowKey: [\"_time\", \"host\", \"port\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"name\", \"host\", \"port\", \"service\", \"product\", \"cves\", \"max_severity\"])\n  |> sort(columns: [\"host\", \"port\"])"
        }
      ],
      "fieldConfig": {
