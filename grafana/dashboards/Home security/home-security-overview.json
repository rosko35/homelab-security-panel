{
  "uid": "home-security-overview",
  "title": "Home security overview",
  "description": "Devices, port scans, log alerts and sensors of the home network in one place.",
  "tags": [
    "homelab",
    "security",
    "network"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "IoT Sensor Panel",
      "type": "link",
      "url": "/d/iot-sensor-overview",
      "icon": "dashboard",
      "tooltip": "Sensor telemetry and alerts",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": []
    }
  ],
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "hbucket",
        "label": "Homelab bucket",
        "hide": 2,
        "query": "homelab",
        "skipUrlSync": false,
        "current": {
          "selected": false,
          "text": "homelab",
          "value": "homelab"
        },
        "options": [
          {
            "selected": true,
            "text": "homelab",
            "value": "homelab"
          }
        ]
      },
      {
        "type": "constant",
        "name": "sbucket",
        "label": "Sensor bucket",
        "hide": 2,
        "query": "sensors",
        "skipUrlSync": false,
        "current": {
          "selected": false,
          "text": "sensors",
          "value": "sensors"
        },
        "options": [
          {
            "selected": true,
            "text": "sensors",
            "value": "sensors"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Network devices",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Devices",
      "id": 2,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"${hbucket}\")\n  |> range(start: -1d)\n  |> filter(fn: (r) => r._measurement == \"homesec_devices\")\n  |> filter(fn: (r) => r._field == \"total\" or r._field == \"online\" or r._field == \"unknown\")\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"total\", \"online\", \"unknown\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "unknown"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "description": "From the latest discovery run. 'unknown' = devices not yet marked with `homesec devices known`."
    },
    {
      "type": "timeseries",
      "title": "Devices over time",
      "id": 3,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 10,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"${hbucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"homesec_devices\")\n  |> filter(fn: (r) => r._field == \"total\" or r._field == \"online\" or r._field == \"unknown\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"total\", \"online\", \"unknown\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "New devices per day",
      "id": 4,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"${hbucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"homesec_new_device\" and r._field == \"value\")\n  |> group()\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: true)\n  |> fill(value: 0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0
          },
          "displayName": "new devices",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "MAC addresses seen for the first time. The first run (baseline) shows up as one spike."
    },
    {
      "type": "table",
      "title": "Recently joined devices",
      "id": 5,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"${hbucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"homesec_new_device\" and r._field == \"ip\")\n  |> group()\n  |> keep(columns: [\"_time\", \"mac\", \"vendor\", \"_value\"])\n  |> rename(columns: {_value: \"ip\", _time: \"first seen\"})\n  |> sort(columns: [\"first seen\"], desc: true)\n  |> limit(n: 50)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Mark devices you recognise: homesec devices known <MAC> --label <name>"
    },
    {
      "type": "row",
      "title": "Port scans (async-vuln-scanner)",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Open ports per device (latest scan)",
      "id": 7,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "lastScan = from(bucket: \"${hbucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"homesec_scan\" and r._field == \"open_ports\")\n  |> last()\n  |> findColumn(fn: (key) => true, column: \"_time\")\nt0 = if length(arr: lastScan) > 0 then lastScan[0] else now()\nfrom(bucket: \"${hbucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"homesec_scan_host\" and r._field == \"open_ports\")\n  |> filter(fn: (r) => r._time == t0)\n  |> group(columns: [\"name\", \"host\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "displayName": "${__field.labels.name} (${__field.labels.host})",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      }
    },
    {
      "type": "stat",
      "title": "CVEs by severity (latest scan)",
      "id": 8,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "lastScan = from(bucket: \"${hbucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"homesec_scan\" and r._field == \"open_ports\")\n  |> last()\n  |> findColumn(fn: (key) => true, column: \"_time\")\nt0 = if length(arr: lastScan) > 0 then lastScan[0] else now()\nfrom(bucket: \"${hbucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"homesec_scan_cves\" and r._field == \"count\")\n  |> filter(fn: (r) => r._time == t0)\n  |> filter(fn: (r) => r.severity != \"UNKNOWN\")\n  |> group(columns: [\"severity\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "displayName": "${__field.labels.severity}",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CRITICAL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HIGH"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "MEDIUM"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LOW"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "UNKNOWN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "description": "Unique CVEs from the NVD for detected product versions. Version matching is a hint, not proof."
    },
    {
      "type": "stat",
      "title": "Latest scan",
      "id": 9,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"${hbucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"homesec_scan\")\n  |> filter(fn: (r) => r._field == \"hosts_scanned\" or r._field == \"open_ports\" or r._field == \"changes\")\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"hosts_scanned\", \"open_ports\", \"changes\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Open ports and CVEs over time",
      "id": 10,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 16,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"${hbucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"homesec_scan\")\n  |> filter(fn: (r) => r._field == \"open_ports\" or r._field == \"unique_cves\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"open_ports\", \"unique_cves\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
