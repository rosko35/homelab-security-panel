    {
      "type": "timeseries",
      "title": "SIEM alerts per hour by rule",
      "id": 15,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 8,
        "y": 30,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
