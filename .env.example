# Copy to .env, or let `python scripts/init_env.py` create .env with random
# secrets filled in. .env is git-ignored: never commit the real file.
# docker compose reads it automatically; `homesec` reads it from the current
# directory when run outside Docker.

# --- Your network -------------------------------------------------------------
# LAN(s) to watch, comma separated. Must be private (RFC 1918) networks.
HOMESEC_NETWORKS=192.168.1.0/24
# Name shown in Telegram messages.
HOMESEC_HOSTNAME=homelab
TZ=Etc/UTC

# --- Telegram (optional) ------------------------------------------------------
# Create a bot with @BotFather, message it once, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates . Leave empty and every
# alert is written to the container logs instead. homesec, mini-siem and the
# IoT ingest all use these two variables, so everything lands in one chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- InfluxDB (required) ------------------------------------------------------
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=
INFLUX_ORG=iot
INFLUX_BUCKET=sensors
INFLUX_RETENTION=30d
# python -c "import secrets; print(secrets.token_urlsafe(48))"
INFLUX_TOKEN=
HOMESEC_INFLUX_BUCKET=homelab

# --- Grafana (required) -------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- mini-siem dashboard (optional second layer, it is on 127.0.0.1 anyway) ---
SIEM_DASHBOARD_USER=
SIEM_DASHBOARD_PASSWORD=

# --- NVD API key (optional, makes weekly CVE lookups ~10x faster) --------------
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Exposure (default: loopback only) ----------------------------------------
# Set to the Pi's LAN address to open a port on purpose, e.g. 192.168.1.10.
GRAFANA_BIND=127.0.0.1
SYSLOG_BIND=127.0.0.1
MQTT_BIND=127.0.0.1

# --- Build sources (default: GitHub) ------------------------------------------
# Uncomment to build the sibling projects from local checkouts.
# SCANNER_SRC=../async-vuln-scanner
# SIEM_SRC=../mini-siem
# IOT_SRC=../iot-sensor-panel
